<style>
  .global-tax-container {
    box-sizing: border-box;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  
  .global-tax-card {
    background: #ffffff;
    width: 100%;
    max-width: 480px;
    margin: 20px auto;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(13, 71, 161, 0.15);
    border: 2px solid #1976d2;
    overflow: hidden;
  }
  
  .global-tax-header {
    background: linear-gradient(135deg, #0d47a1, #1976d2);
    color: #ffffff;
    padding: 24px 20px;
    text-align: center;
  }
  
  .global-tax-header h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
  }
  
  .global-tax-header p {
    margin: 6px 0 0 0;
    font-size: 14px;
    opacity: 0.9;
  }
  
  .global-tax-body {
    padding: 24px 20px;
  }
  
  .input-group {
    margin-bottom: 20px;
  }
  
  .input-group label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #0d47a1;
    margin-bottom: 8px;
  }
  
  .input-flex-wrapper {
    display: flex;
    gap: 8px;
  }
  
  .currency-select, .type-select {
    padding: 12px;
    font-size: 15px;
    border: 2px solid #bbdefb;
    border-radius: 8px;
    outline: none;
    background-color: #e3f2fd;
    color: #0d47a1;
    font-weight: bold;
    cursor: pointer;
  }
  
  .global-input {
    width: 100%;
    padding: 12px 14px;
    font-size: 16px;
    border: 2px solid #bbdefb;
    border-radius: 8px;
    outline: none;
    color: #0d47a1;
    font-weight: 600;
  }
  
  .global-input:focus, .currency-select:focus, .type-select:focus {
    border-color: #1976d2;
  }
  
  .btn-calculate {
    width: 100%;
    background: #1976d2;
    color: #ffffff;
    border: none;
    padding: 14px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
    margin-top: 10px;
    box-shadow: 0 4px 10px rgba(25, 118, 210, 0.3);
  }
  
  .btn-calculate:hover {
    background: #0d47a1;
  }
  
  .btn-calculate:active {
    transform: scale(0.98);
  }
  
  .result-box {
    margin-top: 24px;
    background: #e3f2fd;
    border-radius: 12px;
    padding: 20px;
    border: 1px solid #90caf9;
  }
  
  .result-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px dashed #90caf9;
  }
  
  .result-item:last-child {
    border-bottom: none;
  }
  
  .result-label {
    font-size: 14px;
    color: #1565c0;
    font-weight: 600;
  }
  
  .result-value {
    font-size: 16px;
    color: #0d47a1;
    font-weight: 700;
  }
  
  .highlight-total {
    background: #1976d2;
    color: #ffffff;
    padding: 14px;
    border-radius: 8px;
    margin-bottom: 12px;
  }
  
  .highlight-total .result-label {
    color: #bbdefb;
  }
  
  .highlight-total .result-value {
    color: #ffffff;
    font-size: 22px;
  }
</style>

<div class="global-tax-container">
  <div class="global-tax-card">
    <div class="global-tax-header">
      <h2>GST & Sales Tax Calculator</h2>
      <p>Calculate Add Tax (Exclusive) & Remove Tax (Inclusive)</p>
    </div>
    
    <div class="global-tax-body">
      <div class="input-group">
        <label for="taxAmount">Amount</label>
        <div class="input-flex-wrapper">
          <select id="taxCurrencySymbol" class="currency-select" onchange="calculateTax()">
            <option value="$">$ (USD)</option>
            <option value="€">€ (EUR)</option>
            <option value="£">£ (GBP)</option>
            <option value="₹" selected>₹ (INR)</option>
            <option value="A$">A$ (AUD)</option>
            <option value="C$">C$ (CAD)</option>
            <option value="AED">AED</option>
          </select>
          <input type="number" id="taxAmount" class="global-input" placeholder="e.g. 1000" value="1000">
        </div>
      </div>

      <div class="input-group">
        <label for="taxRate">Tax Rate (%)</label>
        <input type="number" id="taxRate" class="global-input" step="0.1" placeholder="e.g. 18" value="18">
      </div>

      <div class="input-group">
        <label for="taxType">Tax Calculation Type</label>
        <select id="taxType" class="type-select" style="width: 100%;" onchange="calculateTax()">
          <option value="exclusive" selected>Add GST / Tax (Exclusive)</option>
          <option value="inclusive">Remove GST / Tax (Inclusive)</option>
        </select>
      </div>

      <button class="btn-calculate" onclick="calculateTax()">Calculate Tax</button>

      <div class="result-box">
        <div class="result-item highlight-total">
          <span class="result-label">Total Amount:</span>
          <span class="result-value" id="finalTotal">0</span>
        </div>
        <div class="result-item">
          <span class="result-label">Net / Base Amount:</span>
          <span class="result-value" id="baseAmount">0</span>
        </div>
        <div class="result-item">
          <span class="result-label">Tax Amount:</span>
          <span class="result-value" id="calculatedTax">0</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function calculateTax() {
    const amount = parseFloat(document.getElementById('taxAmount').value);
    const rate = parseFloat(document.getElementById('taxRate').value);
    const type = document.getElementById('taxType').value;
    const curr = document.getElementById('taxCurrencySymbol').value;

    if (isNaN(amount) || isNaN(rate) || amount <= 0 || rate < 0) {
      alert("Please enter valid positive numbers for amount and tax rate.");
      return;
    }

    let base, tax, total;

    if (type === 'exclusive') {
      // Add Tax
      base = amount;
      tax = amount * (rate / 100);
      total = amount + tax;
    } else {
      // Remove Tax
      total = amount;
      base = amount / (1 + (rate / 100));
      tax = amount - base;
    }

    const formatCurrency = (num) => {
      return curr + ' ' + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    document.getElementById('finalTotal').innerText = formatCurrency(total);
    document.getElementById('baseAmount').innerText = formatCurrency(base);
    document.getElementById('calculatedTax').innerText = formatCurrency(tax);
  }

  // Calculate automatically on page load
  calculateTax();
</script>
